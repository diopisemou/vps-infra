# Copy to r2.env, fill in, and NEVER commit r2.env (it's gitignored).
# Create this token at: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
# Scope it to the "vps-infra-backups" bucket, Object Read & Write.
#
# ############################################################################
# # READ THIS BEFORE YOU FILL IN RESTIC_PASSWORD                             #
# ############################################################################
# RESTIC_PASSWORD is the encryption key for the backups themselves. Restic has
# no recovery mechanism: lose this string and every snapshot in R2 is
# permanently unreadable, even though the bytes are still sitting there.
#
# The only copy of it must NOT live solely on the servers being backed up.
# That is the exact failure this whole repo exists to prevent - if the servers
# disappear, so does the passphrase, and the backups die with them.
#
# Store it FIRST, in at least two places that are not these servers:
#   - a password manager (1Password / Bitwarden / Apple Passwords), and
#   - somewhere offline (printed, or a file on a drive you keep)
# Use the SAME passphrase on every server so one key restores everything.
# ############################################################################
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=vps-infra-backups
RESTIC_PASSWORD=choose-a-strong-encryption-passphrase-and-save-it-somewhere-safe
